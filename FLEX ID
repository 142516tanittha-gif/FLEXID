<!doctype html>
<html lang="th">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#090817">
<title>FLEX ID | Digital Store</title>
<style>
:root{--bg:#090817;--panel:#121126;--panel2:#191733;--line:#302b55;--purple:#9b5cff;--pink:#ed4ca8;--cyan:#54e6ff;--muted:#aaa7c7;--white:#f7f5ff;--green:#58e6a1}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 80% -10%,#38205e 0,transparent 35%),var(--bg);color:var(--white);font-family:system-ui,-apple-system,"Segoe UI",sans-serif}button,input,select,textarea{font:inherit}button{cursor:pointer}.wrap{width:min(1160px,92%);margin:auto}
header{position:sticky;top:0;z-index:20;background:#090817eF;backdrop-filter:blur(16px);border-bottom:1px solid #ffffff16}.nav{min-height:70px;display:flex;align-items:center;justify-content:space-between;gap:14px}.brand{display:flex;align-items:center;gap:10px;font-weight:1000;letter-spacing:2px;font-size:22px}.logo{width:39px;height:39px;border-radius:13px;display:grid;place-items:center;background:linear-gradient(135deg,var(--purple),var(--pink));box-shadow:0 0 25px #9b5cff66}.navlinks{display:flex;gap:17px;flex-wrap:wrap}.navlinks a{color:var(--muted);text-decoration:none;font-size:13px}.navlinks a:hover{color:white}.actions{display:flex;gap:8px;align-items:center}.btn{border:1px solid var(--line);background:var(--panel2);color:white;padding:10px 13px;border-radius:12px;font-weight:750}.btn.primary{border:0;background:linear-gradient(110deg,#873eff,#db3f9c);box-shadow:0 8px 24px #9b5cff33}.btn.good{background:#164b3b;border-color:#267a5c}.btn.danger{background:#4b2031;border-color:#79314c}.btn:hover{filter:brightness(1.15);transform:translateY(-1px)}.small{font-size:12px;color:var(--muted)}.muted{color:var(--muted)}
main{min-height:70vh}.hero{padding:38px 0 25px}.heroBox{position:relative;overflow:hidden;border:1px solid #ffffff20;border-radius:27px;padding:clamp(25px,6vw,60px);background:linear-gradient(110deg,#21143ded,#100e22ed 58%,#321347);box-shadow:0 24px 80px #0008}.heroBox:after{content:"";position:absolute;width:350px;height:350px;border-radius:50%;right:-70px;top:-100px;background:radial-gradient(circle,#d946ef55,transparent 67%);pointer-events:none}.eyebrow{display:inline-block;border:1px solid #a855f755;background:#a855f71a;color:#e9c8ff;border-radius:999px;padding:7px 12px;font-size:11px;font-weight:800;letter-spacing:1px}.hero h1{font-size:clamp(37px,7vw,68px);line-height:1.04;margin:18px 0}.gradient{background:linear-gradient(90deg,#c084fc,#f472b6,#67e8f9);-webkit-background-clip:text;color:transparent}.hero p{max-width:570px;color:#c6bfd8;line-height:1.8}.heroBtns{display:flex;gap:10px;flex-wrap:wrap;margin-top:23px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:30px}.stat{background:#ffffff0b;border:1px solid #ffffff13;border-radius:14px;padding:14px}.stat b{display:block;font-size:23px}.stat span{font-size:11px;color:var(--muted)}
.section{padding:22px 0 35px}.sectionHead{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:17px}.sectionHead h2{margin:0;font-size:23px}.sectionHead p{margin:4px 0 0;color:var(--muted);font-size:13px}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.product{background:linear-gradient(160deg,#19162f,#100f20);border:1px solid var(--line);border-radius:18px;overflow:hidden;transition:.25s}.product:hover{transform:translateY(-4px);border-color:#9b5cff88;box-shadow:0 15px 35px #0005}.art{height:145px;display:grid;place-items:center;background:radial-gradient(circle at 50% 40%,#673bb055,transparent 60%),linear-gradient(135deg,#1c1838,#111020);font-size:50px}.productBody{padding:15px}.productBody h3{margin:0 0 6px;font-size:16px}.price{font-size:20px;font-weight:900;color:#e9b8ff}.tag{font-size:11px;color:#d7c4ff;background:#8b5cf622;border:1px solid #8b5cf644;padding:5px 8px;border-radius:20px}.row{display:flex;align-items:center;justify-content:space-between;gap:8px}.productActions{display:flex;gap:8px;margin-top:13px}.productActions button{flex:1}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:18px;margin-bottom:14px}.field{width:100%;background:#0d0c1c;color:white;border:1px solid var(--line);border-radius:11px;padding:12px;outline:none}.field:focus{border-color:var(--purple)}.filters{display:grid;grid-template-columns:1fr 190px;gap:10px;margin:15px 0}.chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:15px}.chip{border:1px solid var(--line);background:var(--panel);color:var(--muted);padding:8px 12px;border-radius:30px}.chip.active{background:#813be8;color:white;border-color:#a56aff}
.page{display:none}.page.active{display:block}.two{display:grid;grid-template-columns:1fr 1fr;gap:14px}.formStack{display:grid;gap:10px}.listItem{display:flex;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid #ffffff12}.listItem:last-child{border:0}.notice{padding:12px;border:1px solid #7d5a2c;background:#4b351b55;color:#f7d99d;border-radius:12px;font-size:12px;line-height:1.7}.success{color:var(--green)}.overlay{display:none;position:fixed;inset:0;background:#000b;z-index:50;align-items:center;justify-content:center;padding:15px}.overlay.show{display:flex}.modal{width:min(560px,100%);max-height:90vh;overflow:auto;background:#151329;border:1px solid var(--line);border-radius:20px;padding:20px;box-shadow:0 25px 80px #0009}.modalHead{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}.modalHead h2{margin:0;font-size:20px}.close{border:0;background:#ffffff12;color:white;border-radius:9px;padding:8px 11px}.empty{text-align:center;padding:35px;color:var(--muted)}.faq details{padding:14px 0;border-bottom:1px solid #ffffff14}.faq summary{cursor:pointer;font-weight:700}.faq p{color:var(--muted);font-size:13px;line-height:1.7}
footer{border-top:1px solid #ffffff16;padding:25px 0;color:var(--muted);font-size:12px}.foot{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}.mobileMenu{display:none}
@media(max-width:760px){.navlinks{display:none}.grid{grid-template-columns:repeat(2,1fr)}.stats{grid-template-columns:repeat(2,1fr)}.two{grid-template-columns:1fr}.actions .adminBtn{display:none}}
@media(max-width:480px){.grid{grid-template-columns:1fr}.filters{grid-template-columns:1fr}.brand{font-size:18px}.nav{min-height:62px}.hero{padding-top:20px}.heroBox{border-radius:20px}.productActions{flex-direction:column}}
</style>
</head>
<body>
<header><div class="wrap nav">
 <div class="brand"><div class="logo">F</div> FLEX <span class="gradient">ID</span></div>
 <nav class="navlinks"><a href="#" onclick="showPage('home')">หน้าแรก</a><a href="#" onclick="showPage('shop')">สินค้า</a><a href="#" onclick="showPage('topup')">เติมเงิน</a><a href="#" onclick="showPage('orders')">คำสั่งซื้อ</a><a href="#" onclick="showPage('faq')">ช่วยเหลือ</a></nav>
 <div class="actions"><button class="btn" onclick="showPage('cart')">🛒 <span id="cartCount">0</span></button><button class="btn" onclick="showPage('profile')">👤</button><button class="btn primary adminBtn" onclick="openAdmin()">แอดมิน</button></div>
</div></header>
<main class="wrap">
<section id="home" class="page active">
 <div class="hero"><div class="heroBox"><span class="eyebrow">✦ DIGITAL GOODS MARKETPLACE</span><h1>WELCOME TO<br><span class="gradient">FLEX ID STORE.</span></h1><p>ศูนย์รวมสินค้าดิจิทัล เลือกชมสินค้า ตรวจสอบรายละเอียด และจัดการคำสั่งซื้อได้ในที่เดียว</p><div class="heroBtns"><button class="btn primary" onclick="showPage('shop')">เลือกซื้อสินค้า →</button><button class="btn" onclick="showPage('topup')">เติมเงินเข้ากระเป๋า</button></div>
 <div class="stats"><div class="stat"><b id="statProducts">0</b><span>รายการสินค้า</span></div><div class="stat"><b id="statStock">0</b><span>สินค้าพร้อมขาย</span></div><div class="stat"><b id="statSold">0</b><span>คำสั่งซื้อ</span></div><div class="stat"><b>24/7</b><span>เลือกชมสินค้า</span></div></div></div></div>
 <div class="section"><div class="sectionHead"><div><h2>สินค้าแนะนำ <span class="gradient">✦</span></h2><p>รายการสินค้าจากร้าน FLEX ID</p></div><button class="btn" onclick="showPage('shop')">ดูทั้งหมด →</button></div><div id="featured" class="grid"></div></div>
 <div class="two"><div class="panel"><h3>⚡ ขั้นตอนการสั่งซื้อ</h3><p class="muted">1. เลือกสินค้าและอ่านรายละเอียด</p><p class="muted">2. เพิ่มลงตะกร้าและตรวจสอบยอด</p><p class="muted">3. ส่งคำสั่งซื้อและติดตามสถานะ</p></div><div class="panel"><h3>🛡️ ซื้ออย่างมั่นใจ</h3><p class="muted">ตรวจสอบข้อมูลสินค้า ราคา และเงื่อนไขก่อนทำรายการทุกครั้ง หากมีข้อสงสัยให้ติดต่อผู้ดูแลร้าน</p></div></div>
</section>
<section id="shop" class="page section"><div class="sectionHead"><div><h2>สินค้าทั้งหมด</h2><p>ค้นหาและเลือกหมวดหมู่สินค้า</p></div><span class="small" id="resultCount"></span></div><div class="filters"><input id="search" class="field" placeholder="ค้นหาสินค้า..." oninput="renderProducts()"><select id="sort" class="field" onchange="renderProducts()"><option value="default">เรียงตามแนะนำ</option><option value="low">ราคาน้อยไปมาก</option><option value="high">ราคามากไปน้อย</option></select></div><div class="chips" id="chips"></div><div class="grid" id="productGrid"></div></section>
<section id="cart" class="page section"><div class="sectionHead"><div><h2>🛒 ตะกร้าสินค้า</h2><p>ตรวจสอบรายการก่อนยืนยัน</p></div></div><div class="panel"><div id="cartItems"></div><div class="row"><b>ยอดรวม</b><b class="price" id="cartTotal">฿0</b></div><button class="btn primary" style="width:100%;margin-top:15px" onclick="checkout()">ยืนยันคำสั่งซื้อ</button></div></section>
<section id="topup" class="page section"><div class="sectionHead"><div><h2>เติมเงินเข้ากระเป๋า</h2><p>ระบบจำลองสำหรับทดสอบหน้าร้าน</p></div></div><div class="two"><div class="panel"><h3>ยอดเงินคงเหลือ</h3><div class="price" id="walletBalance">฿0</div><p class="small">ยอดเงินนี้เก็บไว้ในเบราว์เซอร์เครื่องนี้เท่านั้น</p></div><div class="panel"><h3>แจ้งเติมเงิน (ทดลอง)</h3><div class="formStack"><input id="topupAmount" type="number" min="1" class="field" placeholder="จำนวนเงิน (บาท)"><input id="topupRef" class="field" placeholder="เลขอ้างอิง / หมายเหตุ"><button class="btn primary" onclick="requestTopup()">ส่งคำขอเติมเงิน</button></div></div></div><div class="notice">โหมดทดลอง: ไม่มีการเชื่อมต่อธนาคาร, QR Payment หรือการรับเงินจริง คำขอเติมเงินจะถูกบันทึกเป็นรายการรอตรวจสอบในเครื่องนี้</div><div class="panel" style="margin-top:14px"><h3>ประวัติเติมเงิน</h3><div id="topupHistory"></div></div></section>
<section id="orders" class="page section"><div class="sectionHead"><div><h2>ประวัติคำสั่งซื้อ</h2><p>รายการที่ทำจากเบราว์เซอร์นี้</p></div></div><div class="panel" id="orderHistory"></div></section>
<section id="profile" class="page section"><div class="sectionHead"><div><h2>บัญชีสมาชิก</h2><p>ตั้งค่าชื่อที่ใช้แสดงในร้าน</p></div></div><div class="two"><div class="panel"><h3>โปรไฟล์</h3><div class="formStack"><label class="small">ชื่อที่แสดง</label><input id="profileName" class="field" placeholder="ชื่อของคุณ"><button class="btn primary" onclick="saveProfile()">บันทึกข้อมูล</button></div></div><div class="panel"><h3>ข้อมูลบัญชี</h3><p class="muted">ชื่อ: <b id="profileShow">ผู้เยี่ยมชม</b></p><p class="muted">ยอดเงิน: <b id="profileWallet">฿0</b></p><p class="small">หน้านี้เป็นโปรไฟล์ทดลอง ยังไม่มีระบบยืนยันตัวตนจริง</p></div></div></section>
<section id="faq" class="page section"><div class="sectionHead"><div><h2>คำถามที่พบบ่อย</h2><p>ข้อมูลช่วยเหลือสำหรับลูกค้า</p></div></div><div class="panel faq"><details><summary>หลังสั่งซื้อแล้วต้องทำอย่างไร?</summary><p>ตรวจสอบสถานะได้ที่เมนูประวัติคำสั่งซื้อ และติดต่อร้านผ่านช่องทางที่ผู้ดูแลแจ้งไว้</p></details><details><summary>เติมเงินเข้ากระเป๋าได้อย่างไร?</summary><p>ตัวอย่างนี้มีเพียงแบบฟอร์มจำลอง ยังไม่ได้เชื่อมต่อระบบชำระเงินจริง</p></details><details><summary>ทำไมยอดเงินหรือสินค้าไม่เหมือนกันในอุปกรณ์อื่น?</summary><p>ข้อมูลเดโมถูกเก็บในเบราว์เซอร์เครื่องนี้ ไม่ได้ซิงก์ข้ามอุปกรณ์</p></details><details><summary>ขอคืนเงินหรือแจ้งปัญหาได้ที่ไหน?</summary><p>ติดต่อผู้ดูแลร้าน พร้อมแนบหมายเลขคำสั่งซื้อและรายละเอียดปัญหา ควรอ่านเงื่อนไขก่อนสั่งซื้อ</p></details></div></section>
<section id="admin" class="page section"><div class="sectionHead"><div><h2>⚙️ แผงควบคุมร้านค้า</h2><p>จัดการสินค้าในโหมดทดลอง</p></div></div><div class="notice">คำเตือน: แผงนี้ไม่มีระบบล็อกอินที่ปลอดภัย ข้อมูลอยู่ในเบราว์เซอร์เท่านั้น ห้ามใช้จัดการเงินจริงหรือข้อมูลลูกค้าจริง</div><div class="two"><div class="panel"><h3>เพิ่มสินค้า</h3><div class="formStack"><input id="newName" class="field" placeholder="ชื่อสินค้า"><select id="newCategory" class="field"><option>Free Fire</option><option>Roblox</option><option>ROV</option><option>อื่น ๆ</option></select><input id="newPrice" class="field" type="number" min="1" placeholder="ราคา"><input id="newStock" class="field" type="number" min="0" placeholder="จำนวนสต็อก"><textarea id="newDesc" class="field" placeholder="รายละเอียดสินค้า"></textarea><button class="btn primary" onclick="addProduct()">เพิ่มสินค้า</button></div></div><div class="panel"><h3>จัดการรายการสินค้า</h3><div id="adminProducts"></div></div></div><div class="panel"><h3>คำขอเติมเงิน</h3><div id="adminTopups"></div></div></section>
</main>
<footer><div class="wrap foot"><div><b style="color:white;letter-spacing:2px">FLEX ID</b><div>DIGITAL GOODS STORE</div></div><div>© 2026 FLEX ID · Demo storefront</div></div></footer>
<div class="overlay" id="detailModal"><div class="modal"><div class="modalHead"><h2>รายละเอียดสินค้า</h2><button class="close" onclick="closeModal('detailModal')">✕</button></div><div id="detailContent"></div></div></div>
<div class="overlay" id="adminLogin"><div class="modal"><div class="modalHead"><h2>เข้าสู่โหมดผู้ดูแล</h2><button class="close" onclick="closeModal('adminLogin')">✕</button></div><p class="small">รหัสเดโมเริ่มต้น: flexdemo (ไม่ใช่ระบบรักษาความปลอดภัย)</p><input id="adminPass" class="field" type="password" placeholder="รหัสผ่าน"><button class="btn primary" style="width:100%;margin-top:12px" onclick="adminLoginNow()">เข้าสู่ระบบ</button></div></div>
<script>
const starter=[
{id:1,name:"ไอดีเกมตัวอย่าง A",category:"Free Fire",price:99,stock:4,desc:"รายละเอียดสินค้าเดโม สามารถแก้ไขข้อมูลได้จากแผงควบคุม",icon:"🔥"},
{id:2,name:"แพ็กไอเทมตัวอย่าง",category:"Roblox",price:59,stock:8,desc:"ตัวอย่างรายการสินค้าดิจิทัล",icon:"🧱"},
{id:3,name:"ไอดีเกมตัวอย่าง B",category:"ROV",price:149,stock:2,desc:"โปรดตรวจสอบรายละเอียดและเงื่อนไขก่อนสั่งซื้อ",icon:"⚔️"}
];
const read=(k,d)=>{try{return JSON.parse(localStorage.getItem("flex_"+k))??d}catch{return d}};
const save=(k,v)=>localStorage.setItem("flex_"+k,JSON.stringify(v));
let products=read("products",starter),cart=read("cart",[]),orders=read("orders",[]),topups=read("topups",[]),wallet=read("wallet",0),profile=read("profile",""),category="ทั้งหมด";
const money=n=>"฿"+Number(n||0).toLocaleString("th-TH");
function esc(s){return String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
function showPage(id){document.querySelectorAll(".page").forEach(p=>p.classList.remove("active"));document.getElementById(id).classList.add("active");if(id==="cart")renderCart();if(id==="orders")renderOrders();if(id==="topup")renderTopups();if(id==="profile")renderProfile();if(id==="admin")renderAdmin();window.scrollTo({top:0,behavior:"smooth"})}
function closeModal(id){document.getElementById(id).classList.remove("show")}
function openAdmin(){document.getElementById("adminLogin").classList.add("show")}
function adminLoginNow(){if(document.getElementById("adminPass").value!=="flexdemo"){alert("รหัสไม่ถูกต้อง");return}closeModal("adminLogin");showPage("admin")}
function renderChips(){let cats=["ทั้งหมด",...new Set(products.map(p=>p.category))];document.getElementById("chips").innerHTML=cats.map(c=>`<button class="chip ${category===c?"active":""}" onclick="category='${esc(c)}';renderChips();renderProducts()">${esc(c)}</button>`).join("")}
function card(p){return `<article class="product"><div class="art">${esc(p.icon||"🎮")}</div><div class="productBody"><div class="row"><span class="tag">${esc(p.category)}</span><span class="small">คงเหลือ ${p.stock}</span></div><h3>${esc(p.name)}</h3><p class="small">${esc(p.desc)}</p><div class="row"><span class="price">${money(p.price)}</span><span class="small">${p.stock>0?"พร้อมขาย":"สินค้าหมด"}</span></div><div class="productActions"><button class="btn" onclick="showDetail(${p.id})">รายละเอียด</button><button class="btn primary" ${p.stock<1?"disabled":""} onclick="addCart(${p.id})">ใส่ตะกร้า</button></div></div></article>`}
function renderProducts(){let q=(document.getElementById("search")?.value||"").toLowerCase(),arr=products.filter(p=>(category==="ทั้งหมด"||p.category===category)&&(p.name+" "+p.desc+" "+p.category).toLowerCase().includes(q));let s=document.getElementById("sort")?.value;if(s==="low")arr.sort((a,b)=>a.price-b.price);if(s==="high")arr.sort((a,b)=>b.price-a.price);document.getElementById("productGrid").innerHTML=arr.map(card).join("")||'<div class="empty">ไม่พบสินค้า</div>';document.getElementById("resultCount").textContent=arr.length+" รายการ";document.getElementById("featured").innerHTML=products.slice(0,3).map(card).join("")||'<div class="empty">ยังไม่มีสินค้า</div>';document.getElementById("statProducts").textContent=products.length;document.getElementById("statStock").textContent=products.reduce((a,p)=>a+Number(p.stock),0);document.getElementById("statSold").textContent=orders.length;document.getElementById("cartCount").textContent=cart.reduce((a,x)=>a+x.qty,0)}
function showDetail(id){let p=products.find(x=>x.id===id);if(!p)return;document.getElementById("detailContent").innerHTML=`<div class="art" style="border-radius:14px">${esc(p.icon||"🎮")}</div><h3>${esc(p.name)}</h3><p class="muted">${esc(p.desc)}</p><p>หมวดหมู่: ${esc(p.category)} · คงเหลือ ${p.stock}</p><h2 class="price">${money(p.price)}</h2><button class="btn primary" onclick="addCart(${p.id});closeModal('detailModal')">เพิ่มลงตะกร้า</button>`;document.getElementById("detailModal").classList.add("show")}
function addCart(id){let p=products.find(x=>x.id===id);if(!p||p.stock<1)return alert("สินค้าหมด");let x=cart.find(x=>x.id===id);if(x){if(x.qty>=p.stock)return alert("สินค้าไม่เพียงพอ");x.qty++}else cart.push({id,qty:1});save("cart",cart);renderProducts();alert("เพิ่มสินค้าในตะกร้าแล้ว")}
function renderCart(){let box=document.getElementById("cartItems");if(!cart.length){box.innerHTML='<div class="empty">ยังไม่มีสินค้าในตะกร้า</div>'}else box.innerHTML=cart.map(x=>{let p=products.find(p=>p.id===x.id);return p?`<div class="listItem"><div><b>${esc(p.name)}</b><div class="small">${money(p.price)} × ${x.qty}</div></div><div><b>${money(p.price*x.qty)}</b> <button class="close" onclick="removeCart(${p.id})">ลบ</button></div></div>`:""}).join("");document.getElementById("cartTotal").textContent=money(cart.reduce((a,x)=>{let p=products.find(p=>p.id===x.id);return a+(p?p.price*x.qty:0)},0))}
function removeCart(id){cart=cart.filter(x=>x.id!==id);save("cart",cart);renderCart();renderProducts()}
function checkout(){if(!cart.length)return alert("กรุณาเลือกสินค้าก่อน");let total=cart.reduce((a,x)=>{let p=products.find(p=>p.id===x.id);return a+(p?p.price*x.qty:0)},0);if(wallet<total)return alert("ยอดเงินทดลองไม่เพียงพอ กรุณาไปหน้าเติมเงิน (โหมดทดลอง)");for(let x of cart){let p=products.find(p=>p.id===x.id);if(!p||p.stock<x.qty)return alert("สต็อกสินค้าไม่เพียงพอ")}cart.forEach(x=>{let p=products.find(p=>p.id===x.id);p.stock-=x.qty});wallet-=total;orders.unshift({id:"FX"+Date.now().toString().slice(-8),date:new Date().toLocaleString("th-TH"),items:cart.map(x=>({name:products.find(p=>p.id===x.id).name,qty:x.qty})),total,status:"รอตรวจสอบ (เดโม)"});cart=[];saveAll();renderProducts();renderCart();alert("สร้างคำสั่งซื้อทดลองแล้ว");showPage("orders")}
